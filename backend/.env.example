# 이 파일을 .env로 복사해서 쓴다. .env는 올리지 않는다.
# docker-compose.yml로 띄운 로컬 Postgres 기준이다.
# 매니지드(Neon·Supabase)로 옮기면 이 두 줄만 바꾼다.

DATABASE_URL=postgresql+psycopg://teamagent:teamagent@localhost:5432/teamagent
TEST_DATABASE_URL=postgresql+psycopg://teamagent:teamagent@localhost:5432/teamagent_test

# 세션 쿠키 서명 키. 지금 로그인은 비밀번호가 없어서 이 값이 아직 아무것도
# 지키지 않는다 — 없으면 개발용 기본값으로 뜬다. 비밀번호가 생기면 반드시 채운다.
SESSION_SECRET=dev-secret-바꿔서-쓰세요

# AI 키 (https://aistudio.google.com/apikey). 비우면 AI 없이 돈다
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite                       # 다른 공급자로 바꿀 때만
# LLM_ENABLED=false                                   # 키가 있어도 끌 때
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 구글 캘린더 연동 (https://console.cloud.google.com/apis/credentials)
# OAuth 클라이언트 ID, 유형은 웹 애플리케이션. 비우면 연동 없이 돈다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
